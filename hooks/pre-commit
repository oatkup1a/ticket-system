#!/usr/bin/env bash
set -euo pipefail

echo "──────────────────────────────"
echo "🔍  Running pre-commit checks"
echo "──────────────────────────────"

if ! command -v golangci-lint >/dev/null 2>&1; then
  echo "❌ golangci-lint not found!"
  echo "   Install it with:"
  echo "   go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest"
  exit 1
fi

# Allow bypass: SKIP_LINT=1 git commit -m "..."
if [[ "${SKIP_LINT:-0}" == "1" ]]; then
  echo "⚠️  Skipping lint checks (SKIP_LINT=1)."
  exit 0
fi

if golangci-lint run -v --fix; then
  echo "✅ Pre-commit: All lint checks passed!"
else
  echo "❌ Pre-commit: Lint errors found. Please fix before committing."
  exit 1
fi

echo "──────────────────────────────"
echo "✨ Pre-commit checks completed"
echo "──────────────────────────────"
