#!/usr/bin/env bash
set -euo pipefail

echo "──────────────────────────────"
echo "🚀  Running pre-push checks"
echo "──────────────────────────────"

# Allow bypass: SKIP_TESTS=1 git push
if [[ "${SKIP_TESTS:-0}" == "1" ]]; then
  echo "⚠️  Skipping tests (SKIP_TESTS=1)."
  exit 0
fi

if go test ./... -race -cover; then
  echo "✅ Pre-push: All tests passed!"
else
  echo "❌ Pre-push: Tests failed. Push aborted."
  exit 1
fi

echo "──────────────────────────────"
echo "✨ Pre-push checks completed"
echo "──────────────────────────────"
