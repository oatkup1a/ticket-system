# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydb
POSTGRES_PORT=5432

# App (when running in Docker compose's app service)
APP_PORT=8080

# If running the app LOCALLY (not in Docker), set:
# DATABASE_DSN=host=localhost port=5432 user=postgres password=postgres dbname=mydb sslmode=disable
